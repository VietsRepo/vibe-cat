# =============================================================================
# Rule of thumb:
#   IGNORE  -> secrets, generated/build output, caches, logs, personal settings
#   COMMIT  -> source, lock files, shared tool config, *.example templates
#
# Remove sections for stacks you don't use.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ENVIRONMENT VARIABLES & SECRETS  (most important section)
# -----------------------------------------------------------------------------
# Env files - ignore all variants, keep templates
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
!*.env.example
.env.backup

# direnv
.envrc.local
.direnv/

# Private keys & certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.der
id_rsa*
id_ed25519*
id_ecdsa*
*.ppk
# Uncomment if you never commit public certificates
# *.crt
# *.cer

# Cloud / service credentials
credentials.json
*credentials*.json
service-account*.json
*-sa-key.json
gcloud-key*.json
.aws/
.azure/
.gcloud/
.vault-token
.netrc
auth.json

# Generic secret files (keep examples)
secrets.*
*.secret
*.secrets
!secrets.example.*
!*.secret.example


