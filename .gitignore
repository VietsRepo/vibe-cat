# -----------------------------------------------------------------------------
# 6. TERRAFORM / TERRAGRUNT
# -----------------------------------------------------------------------------
# NOTE: DO commit .terraform.lock.hcl (HashiCorp recommendation)
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Variable files usually contain secrets (keep examples)
*.tfvars
*.tfvars.json
!*.tfvars.example
!example.tfvars

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output (terraform plan -out=...)
*.tfplan
tfplan
*tfplan*.json
planout

# CLI config
.terraformrc
terraform.rc

# Terragrunt / Infracost
.terragrunt-cache/
.infracost/


# -----------------------------------------------------------------------------
# 7. KUBERNETES / HELM / KUSTOMIZE
# -----------------------------------------------------------------------------
# Cluster credentials - never commit
kubeconfig
kubeconfig*.yaml
kubeconfig*.yml
*.kubeconfig
.kube/

# Plain Secret manifests (use SealedSecrets / SOPS / External Secrets instead)
*secret*.local.yaml
*secret*.local.yml
secret.yaml
secret.yml
secrets.yaml
secrets.yml
!sealed-secret*.yaml
!*.sops.yaml
!*.enc.yaml

# Helm: downloaded dependencies & packaged charts (commit Chart.lock)
charts/*/charts/*.tgz
charts/*/tmpcharts/
*.helm.tgz
values.local.yaml
values-local.yaml
values.secret.yaml
values-secret*.yaml

# Rendered manifests (helm template / kustomize build output)
/rendered/
/manifests-rendered/


# -----------------------------------------------------------------------------
# 8. CI/CD - JENKINS & GITHUB ACTIONS
# -----------------------------------------------------------------------------
# NOTE: DO commit Jenkinsfile and .github/workflows/*.yml

# Jenkins (local instances / agents / test runs)
jenkins_home/
.jenkins/
jenkins-data/
workspace@tmp/
*@tmp/

# GitHub Actions local runner (nektos/act)
.secrets
.vars
.actrc.local
.act/

# CI artifacts downloaded locally
/artifacts/
/reports/


# -----------------------------------------------------------------------------
# 9. AI CODING TOOLS
# -----------------------------------------------------------------------------
# COMMIT shared AI config so the whole team benefits:
#   CLAUDE.md, AGENTS.md, GEMINI.md, .claude/settings.json, .claude/commands/,
#   .claude/agents/, .claude/skills/, .cursor/rules/, .cursorignore,
#   .github/copilot-instructions.md, .clinerules, .windsurfrules,
#   .kiro/specs/, .aiderignore
# IGNORE only personal settings, caches, chat history and scratch output below.

# Claude Code
CLAUDE.local.md
.claude/settings.local.json
.claude/agent-memory-local/
.claude/*.local.*

# Cursor
.cursor/*.local.*
.cursor/chats/

